# Server Configuration
PORT=8000
HOST=0.0.0.0

# Groq Cloud Inference (~500 tps)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Supabase Database (PostgreSQL Connection String)
# Example: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Fallback local SQLite (used automatically if DATABASE_URL is empty)
DB_FILE=vectordb.sqlite3

# Optional: Local Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_GEN_MODEL=llama3.2

# Optional: OpenAI
OPENAI_API_KEY=
